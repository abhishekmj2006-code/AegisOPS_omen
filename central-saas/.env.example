# =============================================================
# AegisOPS Central SaaS Platform - Environment Configuration
# =============================================================

# Google Gemini API Key (Get free tier key at https://aistudio.google.com/)
# If left empty, AegisOPS seamlessly falls back to the deterministic statistical engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Database URI (Defaults to local SQLite)
SAAS_DATABASE_URL=sqlite:///./central_saas.db
